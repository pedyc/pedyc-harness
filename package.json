{
  "name": "pedyc-harness-workspace",
  "private": true,
  "version": "1.1.0",
  "description": "Configuration-driven Agent Harness workspace",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedyc/pedyc-harness.git"
  },
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "pedyc-harness": "packages/cli/dist/bin.js"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build && tsc -p tsconfig.scripts.json",
    "prepare": "pnpm run build",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "schemas:sync": "node scripts/dist/schemas-sync.js",
    "schemas:check": "node scripts/dist/schemas-sync.js --check",
    "harness:verify": "node scripts/harness/cli.mjs verify",
    "harness:run": "node scripts/harness/cli.mjs run",
    "verify:examples": "node scripts/dist/verify-examples.js",
    "release:check": "node scripts/dist/release-check.js",
    "release:publish": "node scripts/dist/publish.js",
    "test:unit": "pnpm run build && vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@pedyc/harness-core": "workspace:*",
    "@pedyc/harness-preset-generic": "workspace:*",
    "@pedyc/harness-preset-vue": "workspace:*",
    "pedyc-harness": "workspace:*",
    "ajv": "^8.20.0"
  }
}
