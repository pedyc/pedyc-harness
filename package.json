{
  "name": "vue-harness-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "harness:verify": "node .github/harness/verify-config.mjs",
    "harness:run": "node scripts/harness/run.mjs",
    "test:unit": "vitest run"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "ajv": "^8.20.0",
    "vue": "^3.5.42"
  }
}
