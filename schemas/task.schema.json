{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedyc.dev/harness/task.schema.json",
  "title": "Human task intake",
  "type": "object",
  "additionalProperties": false,
  "required": ["task", "goal", "acceptance"],
  "properties": {
    "task": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "scope": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "specialConstraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "maxIterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    }
  }
}
