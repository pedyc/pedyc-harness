{
  "name": "pedyc-harness",
  "version": "1.1.0",
  "description": "Configuration-driven Agent Harness CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pedyc-harness": "dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./run": {
      "types": "./dist/run.d.ts",
      "default": "./dist/run.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedyc/pedyc-harness.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/pedyc/pedyc-harness#readme",
  "bugs": {
    "url": "https://github.com/pedyc/pedyc-harness/issues"
  },
  "keywords": [
    "agent",
    "harness",
    "cli",
    "orchestration",
    "planner",
    "coder",
    "reviewer"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pedyc/harness-core": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json"
  }
}
