{
  "name": "pedyc-harness",
  "version": "1.0.1",
  "description": "Configuration-driven Agent Harness CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pedyc-harness": "src/bin.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./run": "./src/run.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pedyc/pedyc-harness.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/pedyc/pedyc-harness#readme",
  "bugs": {
    "url": "https://github.com/pedyc/pedyc-harness/issues"
  },
  "keywords": [
    "agent",
    "harness",
    "cli",
    "orchestration",
    "planner",
    "coder",
    "reviewer"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@pedyc/harness-core": "workspace:*",
    "@pedyc/harness-preset-generic": "workspace:*",
    "@pedyc/harness-preset-vue": "workspace:*"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "src",
    "templates",
    "README.md"
  ]
}
