{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedyc.dev/harness/input.schema.json",
  "title": "Harness task input",
  "type": "object",
  "additionalProperties": false,
  "required": ["feature", "objective", "acceptanceCriteria"],
  "properties": {
    "feature": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "constraints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "testHints": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "maxIterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3,
      "default": 3
    }
  }
}
