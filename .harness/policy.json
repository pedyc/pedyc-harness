{
  "$schema": "https://pedyc.dev/harness/policy.schema.json",
  "maxIterations": 3,
  "protectedPaths": [".github/", ".claude/", ".agents/", ".harness/", "scripts/"],
  "requiredChecks": ["build", "harness:verify", "schemas:check", "type-check", "test:unit"],
  "forbiddenCommands": ["git reset --hard", "git checkout --", "npm publish"],
  "allowedAgentCommands": [],
  "allowedProductPaths": ["packages/"],
  "agentTimeoutMs": 300000
}
