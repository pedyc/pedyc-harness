{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pedyc.dev/harness/agent-response.schema.json",
  "title": "Harness agent response",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "details": { "type": "string" },
    "approved": { "type": "boolean" },
    "implementationPlan": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "result", "details"],
        "properties": {
          "command": { "type": "string", "minLength": 1 },
          "result": { "enum": ["pass", "fail"] },
          "details": { "type": "string", "minLength": 1 }
        }
      }
    },
    "issues": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "changedFiles": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "findings": {
      "description": "The reviewer's structured judgments. Each rule id must be declared by an implementation; the harness disposes them by severity and action.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["rule", "target", "severity", "reason", "retryable"],
        "properties": {
          "rule": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["error", "warning", "info"] },
          "reason": { "type": "string", "minLength": 1 },
          "retryable": { "type": "boolean" },
          "confidence": { "type": "number" },
          "evidence": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
